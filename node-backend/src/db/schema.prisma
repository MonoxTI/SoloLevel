generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  name         String
  xp           Int           @default(0)
  level        Int           @default(1)
  streak       Int           @default(0)
  lastActive   DateTime?
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  goals        Goal[]
  notebooks    Notebook[]
  todos        Todo[]
}

model Transaction {
  id         String   @id @default(uuid())
  userId     String
  amount     Float
  category   String
  merchant   String?
  note       String?
  date       DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

model Goal {
  id           String    @id @default(uuid())
  userId       String
  title        String
  description  String?
  type         GoalType
  targetValue  Float
  currentValue Float     @default(0)
  deadline     DateTime?
  xpReward     Int       @default(100)
  completed    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Trade {
  id         String      @id @default(uuid())
  userId     String
  symbol     String
  side       TradeSide
  quantity   Float
  entryPrice Float
  exitPrice  Float?
  status     TradeStatus @default(OPEN)
  pnl        Float?
  openedAt   DateTime    @default(now())
  closedAt   DateTime?

  @@index([userId])
  @@index([symbol])
}

/// A named collection of notes. Created and managed via the dashboard.
model Notebook {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  emoji       String   @default("📓")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes       Note[]

  @@index([userId])
}

/// A note inside a notebook. Created via bot or dashboard. Kept forever.
model Note {
  id         String   @id @default(uuid())
  userId     String
  notebookId String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  @@index([notebookId])
  @@index([userId])
}

/// Todos auto-expire 24h after creation. Reminders fire at +10h, +15h, +22h.
model Todo {
  id          String   @id @default(uuid())
  userId      String
  content     String
  completed   Boolean  @default(false)
  reminded10h Boolean  @default(false)
  reminded15h Boolean  @default(false)
  reminded22h Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum GoalType {
  SAVINGS
  SPENDING_LIMIT
  NET_WORTH
  TRADE_TARGET
  CUSTOM
}

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
}
